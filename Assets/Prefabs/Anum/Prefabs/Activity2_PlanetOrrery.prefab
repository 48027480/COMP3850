  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>1.</b>  Pick up a sphere from the display case to read its moment in
    history.


    <b>2.</b>  Place each sphere on a ring of the orrery. Ring 1 is
    the earliest moment, ring 4 the latest.


    <b>3.</b>  Work together: each
    visitor can place up to two spheres, and at least two visitors must take part.


    <b>4.</b> 
    When all four are placed, press Submit on the console. Use the hints if you are
    stuck.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
